# ==========================================
#  红门售后工单系统 - 生产环境配置模板
#  复制为 .env 后按需修改
# ==========================================

# ----- 数据库 -----
DB_PASSWORD=ChangeMe_StrongPass_2024

# ----- Flask -----
SECRET_KEY=ChangeMe_LongRandom_64chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRY_HOURS=2

# ----- 微信 -----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ORDER_STATUS=

# ----- ERP -----
ERP_API_URL=
ERP_API_KEY=

# ==========================================
#  端口配置（生产机有其他项目时改这里）
#  前端建议放公网，后端只在同主机/内网
# ==========================================

# 前端（用户访问入口，建议改成 80/443/Nginx 反代）
HOST_PORT_FRONTEND=18080

# 后端 API（仅同主机或反代，**不要直接暴露公网**）
HOST_PORT_BACKEND=15000

# MySQL（**不要暴露公网**）
HOST_PORT_MYSQL=13306

# Redis（**不要暴露公网**）
HOST_PORT_REDIS=16379

# 容器内固定端口（生产机用户一般不用改）
CONTAINER_PORT_FRONTEND=80
CONTAINER_PORT_BACKEND=5000
CONTAINER_PORT_MYSQL=3306
CONTAINER_PORT_REDIS=6379

# ==========================================
#  Gunicorn（生产 worker 数：CPU 核数 * 2 + 1）
# ==========================================
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=60
