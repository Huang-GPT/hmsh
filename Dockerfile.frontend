FROM node:16-alpine AS builder

WORKDIR /app

# Copy all frontend source. .dockerignore excludes node_modules
# and any local artifacts so the COPY never overwrites the
# freshly-installed node_modules below.
COPY frontend/ ./

# Install dependencies. chmod +x on .bin defends against
# rare alpine base images where npm-installed CLI wrappers
# lose the executable bit.
RUN npm install \
    && chmod -R +x node_modules/.bin

RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]